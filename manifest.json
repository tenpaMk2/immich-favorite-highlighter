{
  "manifest_version": 3,
  "name": "Immich Favorite Highlighter",
  "short_name": "Fav Highlighter",
  "description": "💛 Immich のサムネイルで、お気に入り画像を枠と縁付きハートで強調。白いハートを見失わない。",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Immich Favorite Highlighter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
